---
import '../styles/global.css';
import '../styles/animations.css';
import { t, type Lang } from '../i18n';
import { jsonLd } from '../data/seo';
import { responsive } from '../lib/images';
import { ANTI_FOUC } from '../scripts/anti-fouc.mjs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const strings = t(lang);
const title = strings.pageTitle;
const description = strings.pageDescription;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const portrait = await responsive('profile/portrait.jpg', [600]);
const structuredData = jsonLd(lang, strings, canonicalURL.href, new URL(portrait.src, Astro.site).href);
const altLang = lang === 'es' ? 'en' : 'es';
const altPath = lang === 'es' ? '/en/' : '/';
const altURL = new URL(altPath, Astro.site);
---

<!DOCTYPE html>
<html lang={lang} class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Alvaro Quintana" />
  <meta name="robots" content="index, follow" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <link rel="canonical" href={canonicalURL} />

  <!-- i18n alternates -->
  <link rel="alternate" hreflang={lang} href={canonicalURL} />
  <link rel="alternate" hreflang={altLang} href={altURL} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

  <!-- Theme color -->
  <meta name="theme-color" content="#15110E" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Alvaro Quintana Portfolio" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
  <meta property="og:image" content={new URL('/images/og-image.png', Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${title} — Portfolio`} />
  <meta property="og:image:type" content="image/png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/images/og-image.png', Astro.site)} />
  <meta name="twitter:image:alt" content={`${title} — Portfolio`} />

  <!-- Preload critical assets -->
  <link rel="preload" href="/fonts/Fraunces-900-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/InstrumentSans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Fraunces-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Fraunces-400italic-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Fraunces-600-latin.woff2" as="font" type="font/woff2" crossorigin />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <!-- Anti-FOUC: the only inline script; sets the theme class before paint (theme.js owns the rest) -->
  <script is:inline set:html={ANTI_FOUC} />
</head>
<body>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-(--ink) focus:text-(--paper) focus:rounded focus:font-bold focus:text-sm">
    {strings.skipLink}
  </a>


  <main id="main-content">
    <slot />
  </main>

  <footer class="relative z-10 border-t border-(--line) px-6 py-8 text-center font-mono text-[11px] tracking-[0.06em] text-(--ink-muted)">
    <p>&copy; {new Date().getFullYear()} Álvaro Quintana · {strings.builtWithTech} {strings.techName}</p>
  </footer>

  <script src="../scripts/theme.js"></script>
  <script src="../scripts/scroll-animations.js"></script>
</body>
</html>
