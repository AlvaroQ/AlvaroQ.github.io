---
import type { Strings } from '../i18n/es';
import { contact } from '../data/contact';
import InkSignature from './InkSignature.astro';

interface Props {
  strings: Strings;
  lang: 'es' | 'en';
}

const { strings, lang } = Astro.props;
const altLang = lang === 'es' ? 'en' : 'es';
const altPath = lang === 'es' ? '/en/' : '/';
---

<section id="header" class="relative">
  <!-- Banner -->
  <div id="top-banner" class="absolute top-0 left-0 right-0 z-50 border-b border-(--line) bg-(--paper-2) px-4 py-2 text-center text-xs text-(--ink-muted)">
    <span>{strings.bannerText}</span>
    <a href={`mailto:${contact.email}`} class="link-grow text-(--accent)">{strings.bannerEmail}</a>
  </div>

  <!-- Controls -->
  <div class="header-controls absolute right-4 z-10 flex gap-2">
    <button id="theme-toggle" type="button" class="header-control" aria-label={strings.a11yThemeToggle}>
      <span class="dark-label">{strings.lightMode}</span>
      <span class="light-label" style="display:none">{strings.darkMode}</span>
    </button>
    <a href={altPath} class="header-control" aria-label={strings.a11yLanguageToggle} hreflang={altLang}>{altLang}</a>
  </div>

  <InkSignature strings={strings} />
</section>

<style>
  #header {
    padding: 0;
  }

  .header-controls {
    top: 3rem;
  }

  .header-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--ink-muted);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .header-control:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  /* Below md the controls share the top band with the (narrower) nav pill. */
  @media (max-width: 767px) {
    .header-controls {
      gap: 6px;
    }

    .header-control {
      padding: 0 10px;
    }
  }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = window.toggleTheme();
    const darkLabel = document.querySelector('.dark-label');
    const lightLabel = document.querySelector('.light-label');
    if (next === 'light') {
      darkLabel.style.display = 'none';
      lightLabel.style.display = 'inline';
    } else {
      darkLabel.style.display = 'inline';
      lightLabel.style.display = 'none';
    }
  });

  // Init label state
  (function() {
    var t;
    try { t = localStorage.getItem('portfolio_theme'); } catch(e) {}
    if (t === 'light') {
      var d = document.querySelector('.dark-label');
      var l = document.querySelector('.light-label');
      if (d) d.style.display = 'none';
      if (l) l.style.display = 'inline';
    }
  })();
</script>
