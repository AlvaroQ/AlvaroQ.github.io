---
import type { Lang, Strings } from '../i18n';
import { contact } from '../data/contact';
import Hero from './Hero.astro';

interface Props {
  strings: Strings;
  lang: Lang;
}

const { strings, lang } = Astro.props;
const altLang = lang === 'es' ? 'en' : 'es';
const altPath = lang === 'es' ? '/en/' : '/';
---

<section id="header" class="relative">
  <!-- Banner -->
  <div id="top-banner" class="absolute top-0 left-0 right-0 z-50 border-b border-(--line) bg-(--paper-2) px-4 py-2 text-center text-xs text-(--ink-muted)">
    <span>{strings.bannerText}</span>
    <a href={`mailto:${contact.email}`} class="link-grow text-(--accent)">{strings.bannerEmail}</a>
  </div>

  <!-- Controls -->
  <div class="header-controls absolute right-4 z-10 flex gap-2">
    <!-- Accessible names start with the visible label (WCAG 2.5.3); the purpose follows in sr-only text -->
    <button id="theme-toggle" type="button" class="control">
      <span class="dark-label">{strings.lightMode}</span>
      <span class="light-label">{strings.darkMode}</span>
      <span class="sr-only">, {strings.a11yThemeToggle}</span>
    </button>
    <a href={altPath} class="control" hreflang={altLang}>{altLang}<span class="sr-only" lang={altLang}>, {strings.altLanguageName}</span></a>
  </div>

  <Hero strings={strings} />
</section>

<style>
  #header {
    padding: 0;
  }

  .header-controls {
    top: 3rem;
  }

  /* Each label names the theme the button switches to */
  .light-label,
  :global(html.light) .dark-label {
    display: none;
  }

  :global(html.light) .light-label {
    display: inline;
  }

  /* Below md the controls share the top band with the (narrower) nav pill. */
  @media (max-width: 767px) {
    .header-controls {
      gap: 6px;
    }

    .control {
      padding: 0 10px;
    }
  }
</style>
