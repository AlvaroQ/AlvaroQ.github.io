---
import type { Strings } from '../i18n/es';
import { contact } from '../data/contact';
import SectionHeading from './SectionHeading.astro';

interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
---

<section id="contact">
  <div class="section-container">
    <SectionHeading index="05" title={strings.connect} />

    <div class="grid gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
      <!-- Editorial lead -->
      <div class="animate-on-scroll">
        <p class="font-display text-[clamp(26px,3vw,38px)] leading-[1.2] text-(--ink)">{strings.contactLead}</p>
        <p class="mt-6 font-display text-[clamp(18px,1.8vw,22px)] italic leading-snug text-(--ink-2)">{strings.availableFor}</p>
      </div>

      <!-- Terminal plate: the one mono-heavy block of the site -->
      <div class="terminal animate-on-scroll font-mono text-sm" style="--stagger: 80ms">
        <p class="text-(--accent)">{strings.whoami}</p>
        <p class="mb-4 pl-4 text-(--ink)">{strings.whoamiResult}</p>

        <p class="text-(--accent)">{strings.catContact}</p>
        <div class="mb-4 space-y-1 pl-4">
          <p class="text-(--ink-muted)">
            {strings.emailLabel}
            <button
              id="copy-email"
              type="button"
              class="link-grow cursor-pointer border-none bg-transparent font-mono text-sm text-(--ink)"
              aria-label={strings.a11yCopyEmail}
              data-email={contact.email}
            >
              {contact.email}
            </button>
            <span id="email-copied" class="ml-2 text-xs text-(--accent) opacity-0 transition-opacity" aria-live="polite" aria-atomic="true">{strings.a11yEmailCopied}</span>
          </p>
          <p class="text-(--ink-muted)">
            {strings.locationLabel}
            <span class="text-(--ink)">{contact.location}</span>
          </p>
        </div>

        <p class="text-(--accent)">{strings.catLinks}</p>
        <div class="space-y-1 pl-4">
          <p>
            <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="link-grow text-(--ink)" aria-label={strings.a11yOpenLinkedIn}>{contact.linkedinDisplay}</a>
          </p>
          <p>
            <a href={contact.githubUrl} target="_blank" rel="noopener noreferrer" class="link-grow text-(--ink)" aria-label={strings.a11yOpenGitHub}>{contact.githubDisplay}</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .terminal {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper-2);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
</style>

<script is:inline>
  document.getElementById('copy-email')?.addEventListener('click', async function() {
    var btn = document.getElementById('copy-email');
    var email = btn && btn.dataset.email;
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      const indicator = document.getElementById('email-copied');
      indicator.style.opacity = '1';
      setTimeout(() => { indicator.style.opacity = '0'; }, 2000);
    } catch { /* ignore */ }
  });
</script>
