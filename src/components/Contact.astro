---
import type { Strings } from '../i18n';
import { contact } from '../data/contact';
import Section from './Section.astro';

interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
// Each segment stays on one line so "Senior/Staff" never splits at its slash.
const availability = strings.availableFor.split(' • ');
// The address may only break before the "@" (never inside "gmail.com").
const [emailUser, emailDomain] = contact.email.split('@');
---

<Section id="contact" strings={strings}>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-center lg:gap-16">
      <!-- Editorial lead -->
      <div class="animate-on-scroll">
        <p class="font-display text-[clamp(26px,3vw,38px)] leading-[1.2] text-(--ink)">{strings.contactLead}</p>
        <p class="mt-6 font-display text-[clamp(18px,1.8vw,22px)] italic leading-snug text-balance text-(--ink-2)">
          {availability.map((part, i) => (
            <Fragment>{i > 0 && ' • '}<span class="whitespace-nowrap">{part}</span></Fragment>
          ))}
        </p>
      </div>

      <!-- Terminal plate: the one mono-heavy block of the site -->
      <div class="terminal animate-on-scroll stagger-1 font-mono text-sm">
        <p class="text-(--accent)">{strings.whoami}</p>
        <p class="mb-4 pl-4 text-(--ink)">{strings.whoamiResult}</p>

        <p class="text-(--accent)">{strings.catContact}</p>
        <div class="mb-4 space-y-1 pl-4">
          <p class="text-(--ink-muted)">
            {strings.emailLabel}
            <button
              id="copy-email"
              type="button"
              class="link-grow cursor-pointer border-none bg-transparent font-mono text-sm text-(--ink) [overflow-wrap:normal]"
              data-email={contact.email}
            >
              {emailUser}<wbr />@{emailDomain}<span class="sr-only">, {strings.a11yCopyEmail}</span>
            </button>
            <span id="email-copied" class="ml-2 text-xs text-(--accent) opacity-0 transition-opacity" aria-live="polite" aria-atomic="true">{strings.a11yEmailCopied}</span>
          </p>
          <p class="text-(--ink-muted)">
            {strings.locationLabel}
            <span class="text-(--ink)">{strings.location}</span>
          </p>
        </div>

        <p class="text-(--accent)">{strings.catLinks}</p>
        <div class="space-y-1 pl-4">
          <p>
            <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="link-grow text-(--ink)">{contact.linkedinDisplay}</a>
          </p>
          <p>
            <a href={contact.githubUrl} target="_blank" rel="noopener noreferrer" class="link-grow text-(--ink)">{contact.githubDisplay}</a>
          </p>
        </div>
      </div>
    </div>
</Section>

<style>
  .terminal {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-2);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
</style>

<script>
  const copyButton = document.getElementById('copy-email');
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.email;
    const indicator = document.getElementById('email-copied');
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      if (indicator) {
        indicator.style.opacity = '1';
        setTimeout(() => { indicator.style.opacity = '0'; }, 2000);
      }
    } catch {
      /* clipboard denied: the address stays visible on screen */
    }
  });
</script>
