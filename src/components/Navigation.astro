---
import type { Strings } from '../i18n';
import { navItems } from '../data/sections';

interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
const items = navItems.map(({ id, navKey }) => ({ id, label: strings[navKey] }));
---

<nav id="main-nav" class="fixed top-10 left-1/2 z-50 -translate-x-1/2 transition-[top] duration-300 max-md:left-4 max-md:right-[9rem] max-md:translate-x-0" aria-label={strings.a11yNavigation}>
  <div class="nav-pill flex gap-1 rounded-full border border-(--line) px-3 py-1.5 backdrop-blur-xl">
    {items.map(({ id, label }) => (
      <a
        href={`#${id}`}
        class="nav-link flex min-h-[44px] items-center whitespace-nowrap rounded-full px-2 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-(--ink-muted) transition-colors duration-200 hover:text-(--ink) md:px-3"
        data-section={id}
      >
        {label}
      </a>
    ))}
  </div>
</nav>

<style>
  .nav-pill {
    background: color-mix(in srgb, var(--paper-2) 85%, transparent);
  }

  .nav-link.active {
    color: var(--accent);
  }

  /* Below md the pill shares the top band with the theme/language controls:
     full labels scroll horizontally, with faded edges as a scroll hint. */
  @media (max-width: 767px) {
    .nav-pill {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      /* Snap respects the pill padding, so nothing scrolls on load */
      scroll-padding-inline: 12px;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(to right, transparent, black 12px, black calc(100% - 20px), transparent);
      mask-image: linear-gradient(to right, transparent, black 12px, black calc(100% - 20px), transparent);
    }

    .nav-pill::-webkit-scrollbar {
      display: none;
    }

    .nav-link {
      scroll-snap-align: start;
    }
  }
</style>

<script is:inline>
  (function() {
    const nav = document.getElementById('main-nav');
    if (!nav) return;
    const banner = document.getElementById('top-banner');
    const bannerH = banner ? banner.offsetHeight : 0;

    function onScroll() {
      if (window.scrollY > bannerH) {
        nav.style.top = '0.5rem';
      } else {
        nav.style.top = '';
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
