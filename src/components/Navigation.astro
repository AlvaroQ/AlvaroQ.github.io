---
import type { Strings } from '../i18n/es';

interface Props {
  strings: Strings;
  lang: 'es' | 'en';
}

const { strings, lang } = Astro.props;

const sections = [
  { id: 'header', label: strings.navHome },
  { id: 'about', label: strings.navAbout },
  { id: 'career', label: strings.navCareer },
  { id: 'projects', label: strings.navProjects },
  { id: 'skills', label: strings.navSkills },
  { id: 'contact', label: strings.navContact },
];
---

<nav id="main-nav" class="fixed top-10 left-1/2 -translate-x-1/2 z-50 transition-[top] duration-300" aria-label={strings.a11yNavigation}>
  <div class="nav-pill flex gap-1 rounded-full border border-(--line) px-3 py-1.5 backdrop-blur-xl">
    {sections.map(({ id, label }) => (
      <a
        href={`#${id}`}
        class="nav-link flex min-h-[44px] items-center whitespace-nowrap rounded-full px-2 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-(--ink-muted) transition-colors duration-200 hover:text-(--ink) md:px-3"
        data-section={id}
      >
        <span class="sr-only">{label}</span>
        <span class="hidden md:inline" aria-hidden="true">{label}</span>
        <span class="md:hidden" aria-hidden="true">{label.slice(0, 3)}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .nav-pill {
    background: color-mix(in srgb, var(--paper-2) 85%, transparent);
  }

  .nav-link.active {
    color: var(--accent);
  }

</style>

<script is:inline>
  (function() {
    const nav = document.getElementById('main-nav');
    if (!nav) return;
    const banner = document.getElementById('top-banner');
    const bannerH = banner ? banner.offsetHeight : 0;

    function onScroll() {
      if (window.scrollY > bannerH) {
        nav.style.top = '0.5rem';
      } else {
        nav.style.top = '';
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
