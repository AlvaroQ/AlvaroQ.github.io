---
import type { Strings } from '../i18n/es';

interface Props {
  strings: Strings;
  lang: 'es' | 'en';
}

const { strings, lang } = Astro.props;

const sections = [
  { id: 'header', label: strings.navHome },
  { id: 'about', label: strings.navAbout },
  { id: 'career', label: strings.navCareer },
  { id: 'projects', label: strings.navProjects },
  { id: 'skills', label: strings.navSkills },
  { id: 'contact', label: strings.navContact },
];
---

<nav id="main-nav" class="fixed top-10 left-1/2 -translate-x-1/2 z-50 transition-[top] duration-300" aria-label={strings.a11yNavigation}>
  <div class="flex gap-1 px-4 py-2.5 rounded-full backdrop-blur-xl border border-[var(--neon-cyan-border)]" style="background: rgba(10, 10, 15, 0.7);">
    {sections.map(({ id, label }) => (
      <a
        href={`#${id}`}
        class="nav-link px-2 md:px-3 py-3 min-h-[44px] flex items-center rounded-full text-[0.65rem] md:text-xs uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--neon-cyan)] transition-colors duration-200 whitespace-nowrap"
        data-section={id}
      >
        <span class="sr-only">{label}</span>
        <span class="hidden md:inline" aria-hidden="true">{label}</span>
        <span class="md:hidden" aria-hidden="true">{label.slice(0, 3)}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  :global(html.light) nav > div {
    background: rgba(245, 245, 250, 0.75) !important;
    border-color: rgba(0, 100, 100, 0.2) !important;
  }

  .nav-link.active {
    color: var(--neon-cyan);
    background: var(--neon-cyan-border);
    font-weight: 700;
  }

</style>

<script is:inline>
  (function() {
    const nav = document.getElementById('main-nav');
    if (!nav) return;
    const banner = document.getElementById('top-banner');
    const bannerH = banner ? banner.offsetHeight : 0;

    function onScroll() {
      if (window.scrollY > bannerH) {
        nav.style.top = '0.5rem';
      } else {
        nav.style.top = '';
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
