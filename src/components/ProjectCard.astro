---
// One project card. 'feature' is the editorial row (media at 50%, alternating sides from md);
// 'compact' is a grid tile (media on top, no feature list). Both open the project modal.
import type { Lang, Strings } from '../i18n';
import type { Project } from '../data/projects';
import { mediaFor, type MediaLayout } from '../lib/images';
import ProjectCase from './ProjectCase.astro';

interface Props {
  project: Project;
  /** Zero-based position in the full project list. */
  index: number;
  /** Zero-padded project count, e.g. "09". */
  total: string;
  variant: 'feature' | 'compact';
  strings: Strings;
  lang: Lang;
}

const { project, index, total, variant, strings, lang } = Astro.props;

// 16:10 media box per breakpoint (CSS px): lg, md, mobile.
const LAYOUT: Record<Props['variant'], MediaLayout> = {
  feature: {
    slots: [{ w: 600, h: 375, dpr: 2 }, { w: 488, h: 305, dpr: 2 }, { w: 342, h: 214, dpr: 3 }],
    lg: 600,
    md: 'calc((100vw - 48px) / 2)',
  },
  compact: {
    slots: [{ w: 379, h: 237, dpr: 2 }, { w: 472, h: 295, dpr: 2 }, { w: 342, h: 214, dpr: 3 }],
    lg: 379,
    md: 'calc((100vw - 80px) / 2)',
  },
};

const { caseStudy, links } = project;
const keys = caseStudy.screenshots;
const cover = keys[0] ? await mediaFor(keys[0], LAYOUT[variant]) : null;
const number = String(index + 1).padStart(2, '0');
---

<article
  class:list={['card media-zoom animate-on-scroll group cursor-pointer', `card-${variant}`]}
  style={`--stagger: ${(index % 3) * 80}ms`}
  data-open-case={project.slug}
  role="button"
  tabindex="0"
  aria-label={`${strings.viewDetails}: ${project.title}`}
>
  <div class:list={['media relative overflow-hidden bg-(--paper-2)', cover?.fit === 'contain' && 'media-contain']}>
    {cover ? (
      <img
        src={cover.src}
        srcset={cover.srcset}
        sizes={cover.sizes}
        width={cover.width}
        height={cover.height}
        style={cover.cap}
        alt=""
        class={cover.fit === 'cover' ? 'h-full w-full object-cover object-top' : 'max-h-full max-w-full object-contain'}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="plate font-display text-(--ink-muted)" aria-hidden="true">{project.title.charAt(0)}</span>
    )}
  </div>

  <div class="body grid content-start gap-3">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tracking-[0.1em] text-(--ink-muted)">
      <span>{strings.projectLabel} {number} / {total}</span>
      {project.status === 'live' && <span class="badge badge-live">{strings.liveBadge}</span>}
      {project.status === 'discontinued' && <span class="badge badge-discontinued">{strings.discontinuedBadge}</span>}
    </p>
    <h3 class="title font-display font-semibold leading-[1.05] tracking-[-0.01em] text-(--ink)">{project.title}</h3>
    <p class="font-display text-[17px] italic text-(--accent)">{project.subtitle[lang]}</p>
    <p class:list={['max-w-[48ch] text-[15px] leading-relaxed text-(--ink-muted)', variant === 'compact' && 'line-clamp-3']}>{project.description[lang]}</p>
    {variant === 'feature' && (
      <ul class="feats flex flex-wrap gap-x-4 gap-y-1.5 text-[13px] text-(--ink)">
        {project.features.map((f) => <li>{f[lang]}</li>)}
      </ul>
    )}
    <ul class="flex flex-wrap gap-1.5">
      {project.techStack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
    <div class="mt-1 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <span class="more font-semibold text-(--ink)">{strings.viewCase}</span>
      {links.github && (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="link-grow text-(--ink-muted) hover:text-(--ink)"
          aria-label={`${strings.a11yOpenProject}: ${project.title}`}
        >
          {strings.viewOnGithub}
        </a>
      )}
      {project.status === 'live' && (
        <button
          type="button"
          class="link-grow open-chat-btn text-(--accent)"
          data-action="open-chat"
          aria-label={`${strings.tryIt}: ${project.title}`}
        >
          {strings.tryIt}
        </button>
      )}
    </div>
  </div>

  <ProjectCase project={project} lang={lang} strings={strings} />
</article>

<style>
  .card {
    display: grid;
  }

  .media {
    aspect-ratio: 16 / 10;
  }

  /* Shown whole on the plate when the source cannot fill the box without upscaling */
  .media-contain {
    display: grid;
    place-items: center;
    padding: 16px;
  }

  .media-contain img {
    height: auto;
    width: auto;
  }

  .media img {
    filter: sepia(0.25) contrast(1.05);
  }

  .plate {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 96px;
    font-weight: 600;
  }

  .feats li::before {
    content: "— ";
    color: var(--accent);
  }

  .more {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }

  .card:focus-visible {
    outline-offset: 6px;
  }

  /* Feature: editorial row, media at 50%, alternating sides from md */
  .card-feature {
    border-top: 1px solid var(--line);
  }

  .card-feature .title {
    font-size: clamp(28px, 3vw, 34px);
  }

  .card-feature .body {
    padding: 24px 0 32px;
  }

  @media (min-width: 768px) {
    .card-feature {
      grid-template-columns: 1fr 1fr;
    }

    .card-feature .media,
    .card-feature .body {
      align-self: center;
    }

    .card-feature .body {
      padding: 32px 0 32px 40px;
    }

    .card-feature:nth-child(even) .media {
      order: 2;
    }

    .card-feature:nth-child(even) .body {
      padding: 32px 40px 32px 0;
    }
  }

  @media (min-width: 1024px) {
    .card-feature .body {
      padding-left: 48px;
    }

    .card-feature:nth-child(even) .body {
      padding: 32px 48px 32px 0;
    }
  }

  /* Compact: grid tile, media on top */
  .card-compact {
    align-content: start;
    gap: 18px;
  }

  .card-compact .title {
    font-size: 24px;
  }
</style>
