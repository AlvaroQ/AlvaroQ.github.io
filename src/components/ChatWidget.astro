---
import type { Lang, Strings } from '../i18n';
import { CHAT_API_URL } from '../data/site';
// Emitted as its own file and imported by URL on first use: the delegation script below has no
// static imports, so Astro inlines it and the page makes no widget request before the LCP.
import chatModule from '../scripts/chat-widget.js?url';

interface Props {
  strings: Strings;
  lang: Lang;
}

const { strings, lang } = Astro.props;
const suggestions = [strings.chatSuggestion1, strings.chatSuggestion2, strings.chatSuggestion3];
---

<button
  type="button"
  id="chat-fab"
  class="control fab"
  aria-expanded="false"
  aria-controls="chat-dialog"
  aria-haspopup="dialog"
  aria-label={strings.chatOpen}
>
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12z"></path>
  </svg>
</button>

<dialog
  id="chat-dialog"
  lang={lang}
  aria-labelledby="chat-title"
  data-api={CHAT_API_URL}
  data-module={chatModule}
  data-lang={lang}
  data-typing={strings.chatTyping}
  data-error={strings.chatError}
>
  <header class="head">
    <h2 id="chat-title">{strings.chatTitle}</h2>
    <button type="button" class="control" id="chat-close" aria-label={strings.chatClose}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </header>

  <div id="chat-messages" class="messages" role="log" aria-live="polite" tabindex="0" aria-label={strings.chatTitle}>
    <div class="msg msg-assistant">{strings.chatGreeting}</div>
  </div>

  <div id="chat-suggestions" class="suggestions">
    {suggestions.map((text) => <button type="button" class="btn btn-ghost suggestion">{text}</button>)}
  </div>

  <form id="chat-form" class="form" autocomplete="off">
    <div class="row">
      <label for="chat-input" class="sr-only">{strings.chatInputLabel}</label>
      <input
        id="chat-input"
        class="input"
        type="text"
        maxlength="500"
        autocomplete="off"
        placeholder={strings.chatPlaceholder}
      />
      <button type="submit" id="chat-send" class="btn btn-solid">{strings.chatSend}</button>
    </div>
    <p class="privacy">{strings.chatPrivacy}</p>
  </form>
</dialog>

<style>
  .fab {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    width: 56px;
    height: 56px;
    padding: 0;
    border-radius: var(--radius-pill);
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--ink) 30%, transparent);
    transition: transform 0.2s, background-color 0.2s, border-color 0.2s;
  }

  .fab:hover {
    transform: scale(1.06);
    background: var(--ink);
    border-color: var(--accent);
    color: var(--paper);
  }

  dialog {
    position: fixed;
    inset: auto 20px 20px auto;
    margin: 0;
    padding: 0;
    width: min(380px, calc(100vw - 1.5rem));
    max-width: none;
    height: min(560px, calc(100dvh - 2.5rem));
    max-height: none;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--font-ui);
    box-shadow: 0 12px 48px color-mix(in srgb, var(--ink) 25%, transparent);
  }

  dialog[open] {
    display: flex;
    flex-direction: column;
    animation: chat-in 0.25s var(--ease-ink);
  }

  dialog::backdrop {
    background: color-mix(in srgb, var(--paper) 40%, transparent);
  }

  @keyframes chat-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 8px 8px 20px;
    border-bottom: 1px solid var(--line);
  }

  .head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
  }

  .messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
  }

  .messages :global(.msg) {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    font-size: 14px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .messages :global(.msg-assistant) {
    align-self: flex-start;
    border: 1px solid var(--line);
    border-bottom-left-radius: 4px;
    background: var(--paper);
    color: var(--ink);
  }

  .messages :global(.msg-user) {
    align-self: flex-end;
    border-bottom-right-radius: 4px;
    background: var(--ink);
    color: var(--paper);
  }

  .messages :global(.msg a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .messages :global(.msg code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .messages :global(.msg-typing) {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    align-self: flex-start;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-bottom-left-radius: 4px;
    background: var(--paper);
  }

  .messages :global(.msg-typing .dot) {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    animation: chat-typing 1s infinite;
  }

  .messages :global(.msg-typing .dot:nth-child(2)) { animation-delay: 0.2s; }
  .messages :global(.msg-typing .dot:nth-child(3)) { animation-delay: 0.4s; }

  .messages :global(.vh) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes chat-typing {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 16px 12px;
  }

  .suggestions[hidden] {
    display: none;
  }

  .suggestion {
    min-height: 44px;
    padding: 8px 14px;
    border-color: var(--accent);
    background: var(--paper);
    color: var(--ink);
    font-size: 13px;
    cursor: pointer;
  }

  .suggestion:hover {
    border-color: var(--ink);
  }

  .form {
    padding: 12px 16px 14px;
    border-top: 1px solid var(--line);
  }

  .row {
    display: flex;
    gap: 8px;
  }

  .input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 14px;
  }

  .input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }

  .input:focus {
    border-color: var(--accent);
  }

  .row :global(.btn-solid) {
    cursor: pointer;
  }

  .row :global(.btn-solid:disabled),
  .input:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .privacy {
    margin: 8px 4px 0;
    color: var(--ink-muted);
    font-size: 12px;
    line-height: 1.4;
  }

  @media (max-width: 480px) {
    dialog {
      inset: auto 0.75rem 0.75rem auto;
      height: min(560px, calc(100dvh - 1.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab,
    .fab:hover {
      transition: none;
      transform: none;
    }

    dialog[open] {
      animation: none;
    }

    .messages :global(.msg-typing .dot) {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  // The chat module is loaded on the first interaction, never with the page. Capture phase, so
  // no handler inside a card can swallow the trigger.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest<HTMLElement>('#chat-fab, [data-action="open-chat"]');
    if (!trigger) return;
    event.preventDefault();
    const url = document.querySelector<HTMLElement>('#chat-dialog')?.dataset.module;
    if (!url) return;
    import(/* @vite-ignore */ url)
      .then((chat: typeof import('../scripts/chat-widget.js')) => chat.openChat(trigger))
      .catch((error) => console.error('[chat] could not load the chat module', error));
  }, { capture: true });
</script>
