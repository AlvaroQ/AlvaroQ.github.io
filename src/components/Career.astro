---
import type { Strings } from '../i18n/es';
import { career } from '../data/career';
import SectionHeading from './SectionHeading.astro';

interface Props {
  strings: Strings;
  lang: 'es' | 'en';
}

const { strings, lang } = Astro.props;
const formatPeriod = (period: string) => period.replace('Present', strings.present).replace(' - ', ' — ');

const stats = [
  { value: '+15', label: strings.yearsInTechLabel },
  { value: '+7', label: strings.yearsAtBfyLabel },
  { value: strings.platformsNum, label: strings.platformsLabel },
];
---

<section id="career">
  <div class="section-container">
    <SectionHeading index="02" title={strings.careerTimeline} subtitle={strings.careerSubtitle} />

    <!-- Timeline: vertical below lg, horizontal from lg -->
    <ol class="timeline relative grid gap-10 lg:grid-cols-5 lg:gap-8">
      {career.map((node, i) => (
        <li class="entry animate-on-scroll relative" style={`--stagger: ${i * 80}ms`}>
          <span class="dot" aria-hidden="true"></span>
          <div class="flex items-center gap-3">
            <span class="logo flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-(--paper-2) font-mono text-[11px] text-(--ink-muted)">
              {node.logo ? (
                <img src={node.logo} alt="" class="h-7 w-7 rounded-full object-contain" loading="lazy" decoding="async" width="28" height="28" />
              ) : (
                <span aria-hidden="true">{node.icon}</span>
              )}
            </span>
            <p class="font-mono text-xs text-(--accent)">{formatPeriod(node.period)}</p>
          </div>
          <h3 class="mt-4 font-display text-[22px] font-semibold leading-tight text-(--ink)">{node.company}</h3>
          <p class="mt-1 text-sm font-medium text-(--ink)">{node.role}</p>
          <p class="mt-3 text-sm leading-relaxed text-(--ink-muted)">{node.description[lang]}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {node.skills.map((skill) => <li class="tag">{skill}</li>)}
          </ul>
        </li>
      ))}
    </ol>

    <!-- Stats: large numbers, no cards -->
    <dl class="animate-on-scroll mt-16 grid grid-cols-3 border-t border-(--line) pt-8 lg:mt-20">
      {stats.map((stat) => (
        <div class="stat px-2 sm:px-6">
          <dt class="order-2 mt-2 font-mono text-[10px] uppercase leading-snug tracking-[0.12em] text-(--ink-muted) sm:text-[11px]">{stat.label}</dt>
          <dd class="font-display text-[clamp(40px,6vw,72px)] font-semibold leading-none text-(--ink)">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  /* Vertical rail below lg */
  .timeline {
    padding-left: 28px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--line);
  }

  .dot {
    position: absolute;
    left: -28px;
    top: 16px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--accent);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat + .stat {
    border-left: 1px solid var(--line);
  }

  .stat:first-child {
    padding-left: 0;
  }

  /* Horizontal rail from lg */
  @media (min-width: 1024px) {
    .timeline {
      padding-left: 0;
      padding-top: 28px;
    }

    .timeline::before {
      left: 0;
      right: 0;
      top: 4px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .dot {
      left: 0;
      top: -28px;
    }
  }
</style>
