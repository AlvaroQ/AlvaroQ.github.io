---
import type { Strings } from '../i18n/es';
import { career } from '../data/career';

interface Props {
  strings: Strings;
  lang: 'es' | 'en';
}

const { strings, lang } = Astro.props;
---

<section id="career" class="py-20">
  <div class="section-container">
    <div class="text-center mb-12 animate-on-scroll slide-up">
      <h2 class="text-2xl md:text-4xl font-bold text-[var(--neon-cyan)] tracking-[2px] neon-text">
        {strings.careerTimeline}
      </h2>
      <p class="text-sm text-[var(--text-secondary)] mt-2">{strings.careerSubtitle}</p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Connection line (desktop) -->
      <div class="hidden md:block timeline-line"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
        {career.map((node, i) => (
          <div
            class="animate-on-scroll slide-up neon-card timeline-card text-center group flex flex-col relative z-10"
            style={`animation-delay: ${i * 100}ms; border-color: ${node.color};`}
          >
            <!-- Icon -->
            <div class="w-14 h-14 rounded-full mx-auto mb-3 flex items-center justify-center text-sm font-bold overflow-hidden"
                 style={`border: 2px solid ${node.color}; color: ${node.color};`}>
              {node.logo ? (
                <img src={node.logo} alt={node.company} class="w-10 h-10 object-contain rounded-full bg-[var(--logo-bg)]" loading="lazy" decoding="async" width="40" height="40" />
              ) : (
                <span>{node.icon}</span>
              )}
            </div>

            <!-- Info -->
            <h3 class="text-sm font-bold mb-1" style={`color: ${node.color};`}>{node.company}</h3>
            <p class="text-[0.65rem] text-[var(--text-secondary)] mb-1">{node.period}</p>
            <p class="text-xs font-medium text-[var(--text-primary)] mb-2">{node.role}</p>
            <p class="text-[0.65rem] text-[var(--text-secondary)] mb-3 leading-relaxed">{node.description[lang]}</p>

            <!-- Skills -->
            <div class="flex flex-wrap justify-center gap-1">
              {node.skills.map((skill) => (
                <span class="tech-pill text-[0.65rem]">{skill}</span>
              ))}
            </div>

            <!-- Type badge -->
            <span class="inline-block mt-auto pt-3 text-[0.65rem] tracking-widest opacity-50 uppercase">{node.type}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4 mt-14 animate-on-scroll fade-in">
      <div class="neon-card text-center">
        <p class="text-2xl font-bold text-[var(--neon-cyan)]">+15</p>
        <p class="text-[0.7rem] text-[var(--text-secondary)] tracking-wider">{strings.yearsInTechLabel}</p>
      </div>
      <div class="neon-card text-center">
        <p class="text-2xl font-bold text-[var(--neon-magenta)]">+7</p>
        <p class="text-[0.7rem] text-[var(--text-secondary)] tracking-wider">{strings.yearsAtBfyLabel}</p>
      </div>
      <div class="neon-card text-center">
        <p class="text-2xl font-bold text-[var(--neon-green)]">{strings.platformsNum}</p>
        <p class="text-[0.7rem] text-[var(--text-secondary)] tracking-wider">{strings.platformsLabel}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-card {
    background: rgba(26, 26, 46, 0.92);
  }

  :global(html.light) .timeline-card {
    background: rgba(255, 255, 255, 0.95);
  }
</style>
