---
import type { Lang, Strings } from '../i18n';
import { career, type Period } from '../data/career';
import Section from './Section.astro';
import { fixed } from '../lib/images';
import { YEARS_AT_COMPANY, YEARS_IN_TECH } from '../data/site';

interface Props {
  strings: Strings;
  lang: Lang;
}

const { strings, lang } = Astro.props;
const formatPeriod = ({ from, to }: Period) => (from === to ? String(from) : `${from} — ${to ?? strings.present}`);

// Logos render at 28 CSS px; 1x/2x/3x variants keep them sharp on every DPR.
const logos = await Promise.all(career.map((node) => (node.logo ? fixed(node.logo, 28) : null)));

const stats = [
  { value: `+${YEARS_IN_TECH}`, label: strings.yearsInTechLabel },
  { value: `+${YEARS_AT_COMPANY}`, label: strings.yearsAtBfyLabel },
  { value: strings.platformsNum, label: strings.platformsLabel },
];
---

<Section id="career" strings={strings} subtitle={strings.careerSubtitle}>

    <!-- Timeline: vertical below lg, horizontal from lg -->
    <ol class="timeline relative grid gap-10 lg:grid-cols-5 lg:gap-8">
      {career.map((node, i) => (
        <li class={`entry animate-on-scroll relative stagger-${i}`}>
          <span class="dot" aria-hidden="true"></span>
          <div class="flex items-center gap-3">
            <span class="logo flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-(--paper-2) font-mono text-[11px] text-(--ink-muted)">
              {logos[i] ? (
                <img src={logos[i].src} srcset={logos[i].srcset} alt="" class="h-7 w-7 rounded-full object-contain" loading="lazy" decoding="async" width={logos[i].width} height={logos[i].height} />
              ) : (
                <span aria-hidden="true">{node.icon}</span>
              )}
            </span>
            <p class="label-ui text-(--accent)">{formatPeriod(node.period)}</p>
          </div>
          <h3 class="mt-4 font-display text-[22px] font-semibold leading-tight text-(--ink)">{node.company}</h3>
          <p class="mt-1 text-sm font-medium text-(--ink)">{node.role[lang]}</p>
          <p class="mt-3 text-sm leading-relaxed text-(--ink-muted)">{node.description[lang]}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {node.skills.map((skill) => <li class="tag">{skill}</li>)}
          </ul>
        </li>
      ))}
    </ol>

    <!-- Stats: large numbers, no cards -->
    <dl class="animate-on-scroll mt-16 grid grid-cols-3 border-t border-(--line) pt-8 lg:mt-20">
      {stats.map((stat) => (
        <div class="stat px-2 sm:px-6">
          <dt class="label-index order-2 mt-2 leading-snug text-(--ink-muted)">{stat.label}</dt>
          <dd class="font-display text-[clamp(40px,6vw,72px)] font-semibold leading-none text-(--ink)">{stat.value}</dd>
        </div>
      ))}
    </dl>
</Section>

<style>
  /* Vertical rail below lg */
  .timeline {
    padding-left: 28px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--line);
  }

  .dot {
    position: absolute;
    left: -28px;
    top: 16px;
    width: 9px;
    height: 9px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    border: 1px solid var(--accent);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat + .stat {
    border-left: 1px solid var(--line);
  }

  .stat:first-child {
    padding-left: 0;
  }

  /* Horizontal rail from lg */
  @media (min-width: 1024px) {
    .timeline {
      padding-left: 0;
      padding-top: 28px;
    }

    .timeline::before {
      left: 0;
      right: 0;
      top: 4px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .dot {
      left: 0;
      top: -28px;
    }
  }
</style>
