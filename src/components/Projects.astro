---
import type { Lang, Strings } from '../i18n';
import { projects } from '../data/projects';
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectRipple from './ProjectRipple.astro';

interface Props {
  strings: Strings;
  lang: Lang;
}

const { strings, lang } = Astro.props;
const total = String(projects.length).padStart(2, '0');

// The first four projects are the editorial features; the rest form a three-column grid.
const FEATURED = 4;
const featured = projects.slice(0, FEATURED);
const rest = projects.slice(FEATURED);
---

<ProjectRipple>
  <Section id="projects" strings={strings} subtitle={strings.showcasingProjects}>
    <div class="featured border-b border-(--line)">
      {featured.map((project, i) => (
        <ProjectCard project={project} index={i} total={total} variant="feature" stagger={i % 3} strings={strings} lang={lang} />
      ))}
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {rest.map((project, i) => (
        <ProjectCard project={project} index={FEATURED + i} total={total} variant="compact" stagger={i % 3} strings={strings} lang={lang} />
      ))}
    </div>
  </Section>
</ProjectRipple>
