---
import type { Strings } from '../i18n/es';
import { projects } from '../data/projects';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  strings: Strings;
  lang: 'es' | 'en';
}

const { strings, lang } = Astro.props;
const total = String(projects.length).padStart(2, '0');

// The first three projects (data row 1) are the editorial features; the rest form a grid.
const FEATURED = 3;
const featured = projects.slice(0, FEATURED);
const rest = projects.slice(FEATURED);
---

<section id="projects">
  <div class="section-container">
    <SectionHeading index="03" title={strings.latestAiProjects} subtitle={strings.showcasingProjects} />

    <div class="featured border-b border-(--line)">
      {featured.map((project, i) => (
        <ProjectCard project={project} index={i} total={total} variant="feature" strings={strings} lang={lang} />
      ))}
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {rest.map((project, i) => (
        <ProjectCard project={project} index={FEATURED + i} total={total} variant="compact" strings={strings} lang={lang} />
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    function openModal(card) {
      if (!window.projectModal) return;
      var data = {
        title: card.dataset.projectTitle,
        subtitle: card.dataset.projectSubtitle,
        description: card.dataset.projectDescription,
        longDescription: card.dataset.projectLongDesc,
        architecture: card.dataset.projectArchitecture,
        accentColor: card.dataset.projectAccent,
        screenshots: JSON.parse(card.dataset.projectScreenshots || '[]'),
        thumbs: JSON.parse(card.dataset.projectThumbs || '[]'),
        keyHighlights: JSON.parse(card.dataset.projectHighlights || '[]'),
        demoUrl: card.dataset.projectDemo || null,
        githubUrl: card.dataset.projectGithub || null,
        techStack: JSON.parse(card.dataset.projectTech || '[]')
      };
      window.projectModal.open(data);
    }

    document.querySelectorAll('[data-featured="true"]').forEach(function(card) {
      card.addEventListener('click', function() { openModal(card); });
      card.addEventListener('keydown', function(e) {
        if (e.target !== card) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(card);
        }
      });
    });
  });
</script>
