---
import Navigation from './Navigation.astro';
import Header from './Header.astro';
import Presentation from './Presentation.astro';
import Career from './Career.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Contact from './Contact.astro';
import ChatWidget from './ChatWidget.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
---

<Navigation strings={strings} />
<Header strings={strings} lang={lang} />
<Presentation strings={strings} lang={lang} />
<Career strings={strings} lang={lang} />
<Projects strings={strings} lang={lang} />
<Skills strings={strings} lang={lang} />
<Contact strings={strings} />

<ChatWidget strings={strings} lang={lang} />

<!-- Project Modal -->
<script is:inline src="/scripts/project-modal.js" defer></script>
<script is:inline define:vars={{ lang }}>
  document.addEventListener('DOMContentLoaded', () => {
    var theme = document.documentElement.classList.contains('light') ? 'light' : 'dark';
    window.projectModal = new ProjectDetailModal();
    window.projectModal.setTheme(theme);
    document.addEventListener('themechange', function (e) { window.projectModal.setTheme(e.detail.theme); });
    window.projectModal.setLang(lang);
  });
</script>
