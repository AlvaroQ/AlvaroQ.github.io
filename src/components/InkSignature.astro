---
// Hero signature: the name is living marbled ink (WebGL), drawn over a
// static gradient h1 that is always painted (LCP, fallback, accessibility).
import type { Strings } from '../i18n';
import { contact } from '../data/contact';
import { responsive } from '../lib/images';

interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
const [firstName, ...rest] = strings.name.split(' ');
const lastName = rest.join(' ');
// Watermark height map (generate-relief.js): the script picks the variant that covers the
// canvas, never wider than the 1200 px master.
const reliefHeight = await responsive('profile/portrait-relief-height.jpg', [600, 900, 1200]);
---

<div class="hero" data-ink>
  <div class="hero-inner">
    <p class="eyebrow hero-enter" style="--step: 0">{strings.heroEyebrow}</p>
    <div class="ink-box hero-enter-name" style="--step: 1">
      <h1 class="ink-name" aria-label={strings.name}><span class="ink-word">{firstName}</span> <span class="ink-word">{lastName}</span></h1>
      <canvas class="fx" aria-hidden="true"></canvas>
    </div>
    <p class="headline hero-enter" style="--step: 2">{strings.heroHeadline} <em>{strings.heroHeadlineEm}</em></p>
    <div class="platforms-row hero-enter" style="--step: 2">
      <p class="platforms">{strings.platforms}</p>
      <button
        class="ink-pause"
        type="button"
        aria-pressed="false"
        data-usable="false"
        data-label-pause={strings.inkPause}
        data-label-resume={strings.inkResume}
      >{strings.inkPause}</button>
    </div>
    <div class="ctas hero-enter" style="--step: 3">
      <a class="btn btn-solid" href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={strings.a11yOpenLinkedIn}>{strings.linkedIn}</a>
      <a class="btn btn-ghost" href={contact.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={strings.a11yOpenGitHub}>{strings.github}</a>
    </div>
  </div>
  <!-- Watermark portrait pressed into the paper (ink-watermark.js); absolute, so it never moves the layout -->
  <div class="wm-clip" aria-hidden="true">
    <canvas class="wm" data-height-srcset={reliefHeight.srcset}></canvas>
  </div>
</div>

<style>
  .hero {
    position: relative;
    /* Capped so tall viewports (tablets, large monitors) do not open empty bands */
    min-height: min(100svh, 640px);
    display: grid;
    align-items: center;
    isolation: isolate;
    touch-action: pan-y;
  }

  /* Paper veins across the whole hero, as in scenario A: a static vector noise mask
     (no bitmap, so it cannot pixelate) tinted with the second ink. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-color: var(--ink-2);
    opacity: var(--vein-opacity, 0.1);
    -webkit-mask: url("/images/paper-veins.svg") center / cover no-repeat;
    mask: url("/images/paper-veins.svg") center / cover no-repeat;
  }

  :global(html.light) .hero::before {
    --vein-opacity: 0.08;
  }

  .hero-inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 128px 56px 72px;
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .ink-box {
    position: relative;
    max-width: 100%;
  }

  /* Static layer: always painted, never transparent without its gradient. */
  .ink-name {
    display: grid;
    width: max-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "opsz" 144;
    font-size: clamp(64px, 10.5vw, 150px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--ink);
    background: linear-gradient(120deg, var(--ink) 20%, var(--ink-2) 55%, var(--accent) 80%, var(--ink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ink-word {
    display: block;
    width: max-content;
  }

  .fx {
    position: absolute;
    left: -24px;
    top: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    display: block;
    pointer-events: none;
    visibility: hidden;
    z-index: 1;
  }

  .hero:global(.running) .fx {
    visibility: visible;
  }

  .headline {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 400;
    font-variation-settings: "opsz" 36;
    line-height: 1.25;
    color: var(--ink);
    max-width: 28ch;
  }

  .headline em {
    font-style: italic;
    white-space: nowrap;
    color: var(--accent);
  }

  .platforms {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .platforms-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .ink-pause {
    min-height: 32px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--ink-muted);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  /* The control appears once the effect starts: its slot stays reserved so the
     row never reflows (it would shift the CTAs and everything below). */
  .ink-pause[data-usable="false"] {
    visibility: hidden;
  }

  /* The effect never starts under reduced motion: no slot needed. */
  @media (prefers-reduced-motion: reduce) {
    .ink-pause {
      display: none;
    }
  }

  .ink-pause[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 639px) {
    .hero {
      min-height: auto;
      align-items: start;
    }

    .hero-inner {
      padding: 128px 22px 48px;
    }

    .ink-name {
      font-size: clamp(56px, 17vw, 84px);
    }

    /* Own line for the pause control on phones: whether it fits next to the
       platforms would depend on the mono font having loaded (layout shift). */
    .platforms-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

  }

  /* Watermark: clipped to the hero so it can bleed off the edge without widening the page */
  .wm-clip {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .wm {
    position: absolute;
    display: block;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hero:global(.wm-ready) .wm {
    opacity: 1;
  }

  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .ink-name {
      background: none;
      -webkit-text-fill-color: currentColor;
    }
  }

  @media (forced-colors: active) {
    .ink-name {
      background: none;
      color: CanvasText;
      -webkit-text-fill-color: CanvasText;
    }

    .fx,
    .hero::before,
    .wm-clip {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/ink-signature.js';
  import '../scripts/ink-watermark.js';
</script>
