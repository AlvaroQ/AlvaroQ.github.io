---
// Hero signature: the name is living marbled ink (WebGL), drawn over a
// static gradient h1 that is always painted (LCP, fallback, accessibility).
import type { Strings } from '../i18n/es';
import { contact } from '../data/contact';

interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
const [firstName, ...rest] = strings.name.split(' ');
const lastName = rest.join(' ');
---

<div class="hero" data-ink>
  <div class="hero-inner">
    <p class="eyebrow">{strings.heroEyebrow}</p>
    <div class="ink-box">
      <h1 class="ink-name" aria-label={strings.name}><span class="ink-word">{firstName}</span><span class="ink-word">{lastName}</span></h1>
      <canvas class="fx" aria-hidden="true"></canvas>
    </div>
    <p class="headline">{strings.heroHeadline} <em>{strings.heroHeadlineEm}</em></p>
    <p class="platforms">{strings.platforms}</p>
    <div class="ctas">
      <a class="btn btn-solid" href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={strings.a11yOpenLinkedIn}>{strings.linkedIn}</a>
      <a class="btn btn-ghost" href={contact.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={strings.a11yOpenGitHub}>{strings.github}</a>
    </div>
  </div>
  <button
    class="ink-pause"
    type="button"
    aria-pressed="false"
    hidden
    data-label-pause={strings.inkPause}
    data-label-resume={strings.inkResume}
  >{strings.inkPause}</button>
</div>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    isolation: isolate;
    touch-action: pan-y;
  }

  .hero-inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding: 128px 56px 88px;
    display: grid;
    gap: 22px;
    justify-items: start;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .ink-box {
    position: relative;
    max-width: 100%;
  }

  /* Static layer: always painted, never transparent without its gradient. */
  .ink-name {
    display: grid;
    width: max-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: "opsz" 144;
    font-size: clamp(64px, 10.5vw, 150px);
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--ink);
    background: linear-gradient(120deg, var(--ink) 20%, var(--ink-2) 55%, var(--accent) 80%, var(--ink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ink-word {
    display: block;
    width: max-content;
  }

  .fx {
    position: absolute;
    left: -24px;
    top: -24px;
    width: calc(100% + 48px);
    height: calc(100% + 48px);
    display: block;
    pointer-events: none;
    visibility: hidden;
    z-index: 1;
  }

  .hero:global(.running) .fx {
    visibility: visible;
  }

  .headline {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 400;
    font-variation-settings: "opsz" 36;
    line-height: 1.25;
    color: var(--ink);
    max-width: 28ch;
  }

  .headline em {
    font-style: italic;
    white-space: nowrap;
    color: var(--accent);
  }

  .platforms {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 22px;
    border-radius: 999px;
    border: 1.5px solid transparent;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s, background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-solid {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-ghost {
    border-color: var(--line);
    color: var(--ink);
  }

  .btn-ghost:hover {
    border-color: var(--ink);
  }

  .ink-pause {
    position: absolute;
    left: calc(max(0px, (100% - 1200px) / 2) + 56px);
    bottom: 32px;
    z-index: 2;
    min-height: 32px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--ink-muted);
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .ink-pause[hidden] {
    display: none;
  }

  .ink-pause[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 639px) {
    .hero {
      min-height: auto;
      align-items: start;
    }

    .hero-inner {
      padding: 148px 22px 96px;
    }

    .ink-name {
      font-size: clamp(56px, 17vw, 84px);
    }

    .ink-pause {
      left: 22px;
      bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }

    .btn:hover {
      transform: none;
    }
  }

  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .ink-name {
      background: none;
      -webkit-text-fill-color: currentColor;
    }
  }

  @media (forced-colors: active) {
    .ink-name {
      background: none;
      color: CanvasText;
      -webkit-text-fill-color: CanvasText;
    }

    .fx {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/ink-signature.js';
</script>
