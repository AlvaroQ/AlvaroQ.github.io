---
// Section wrapper: anchor id, container and the numbered heading from src/data/sections.ts.
import type { Strings } from '../i18n';
import { sectionById, type SectionId } from '../data/sections';
import SectionHeading from './SectionHeading.astro';

interface Props {
  id: SectionId;
  strings: Strings;
  subtitle?: string;
}

const { id, strings, subtitle } = Astro.props;
const section = sectionById(id);
---

<section id={id}>
  <div class="section-container">
    <SectionHeading index={section.index} title={strings[section.titleKey]} subtitle={subtitle} />
    <slot />
  </div>
</section>
