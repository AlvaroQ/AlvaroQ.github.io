---
// One native <dialog> for every case study, plus a second one for the enlarged screenshots.
// The cases themselves live in <template data-case> inside each card (see ProjectCase.astro);
// project-modal.js is only fetched the first time a visitor opens one.
import type { Strings } from '../i18n';
// Emitted as its own file and imported by URL on first use: the delegation script below has no
// static imports, so Astro inlines it and the page makes no widget request before the LCP.
import modalModule from '../scripts/project-modal.js?url';

interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
---

<dialog id="project-modal" aria-labelledby="project-modal-title" data-module={modalModule}>
  <form method="dialog" class="modal-close-form">
    <button class="control modal-close" aria-label={strings.caseClose}>&times;</button>
  </form>
  <div id="project-modal-content" class="modal-content" tabindex="0" role="region" aria-label={strings.caseContentLabel}></div>
</dialog>

<dialog id="project-lightbox" aria-label={strings.lightboxLabel} data-counter={strings.lightboxCounter}>
  <form method="dialog" class="lb-close-form">
    <button class="control lb-control lb-close" aria-label={strings.lightboxClose}>&times;</button>
  </form>
  <button type="button" class="control lb-control lb-nav lb-prev" aria-label={strings.lightboxPrev}>&lsaquo;</button>
  <button type="button" class="control lb-control lb-nav lb-next" aria-label={strings.lightboxNext}>&rsaquo;</button>
  <p class="lb-counter" aria-live="polite"></p>
  <div class="lb-stage"><img class="lb-img" alt="" /></div>
</dialog>

<script>
  // Delegated open: the heavy module is imported lazily, on the first interaction.
  const dialog = document.querySelector<HTMLDialogElement>('#project-modal');

  function open(trigger: HTMLElement) {
    const slug = trigger.dataset.openCase;
    if (!dialog || !slug) return;
    const url = dialog.dataset.module;
    if (!url) return;
    void import(/* @vite-ignore */ url).then((m: typeof import('../scripts/project-modal.js')) => m.openCase(dialog, slug, trigger));
  }

  function triggerOf(e: Event): HTMLElement | null {
    const target = e.target instanceof Element ? e.target : null;
    const trigger = target?.closest<HTMLElement>('[data-open-case]') ?? null;
    const inner = target?.closest('a, button');
    return trigger && (!inner || inner === trigger) ? trigger : null;
  }

  document.addEventListener('click', (e) => {
    const trigger = triggerOf(e);
    if (trigger) open(trigger);
  });

  document.addEventListener('keydown', (e) => {
    const trigger = triggerOf(e);
    if (!trigger || e.target !== trigger || trigger.tagName === 'BUTTON') return;
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      open(trigger);
    }
  });
</script>

<style>
  #project-modal {
    --box-radius: var(--radius-md);
    position: fixed;
    inset: 0;
    margin: auto;
    width: calc(100% - 2rem);
    max-width: 800px;
    max-height: 90dvh;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--box-radius);
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--font-ui);
  }

  /* Wider box from 1024 px: one 1000-ish column up to 1279, two columns from 1280 (ProjectCase) */
  @media (min-width: 1024px) {
    #project-modal {
      --box-radius: var(--radius-md);
      max-width: 1200px;
      max-height: 92dvh;
    }
  }

  #project-modal[open] {
    display: flex;
    flex-direction: column;
    animation: modal-in 0.3s var(--ease-ink);
  }

  #project-modal::backdrop,
  #project-lightbox::backdrop {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  :global(body:has(#project-modal[open])) {
    overflow: hidden;
  }

  .modal-close-form {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 1;
    margin: 0;
  }

  .modal-close {
    font-size: 24px;
    background: var(--paper-2);
  }

  .modal-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
  }

  /* Enlarged screenshot */
  #project-lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }

  #project-lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-fade 0.25s var(--ease-ink);
  }

  #project-lightbox::backdrop {
    background: color-mix(in srgb, var(--paper) calc(96% * var(--lb-dim, 1)), transparent);
  }

  .lb-control {
    position: absolute;
    z-index: 1;
    background: var(--paper-2);
    font-size: 24px;
  }

  .lb-close-form {
    display: contents;
  }

  .lb-close {
    top: 16px;
    right: 16px;
  }

  .lb-nav {
    top: 50%;
    margin-top: -22px;
    border-radius: var(--radius-pill);
  }

  .lb-prev {
    left: 16px;
  }

  .lb-next {
    right: 16px;
  }

  .lb-nav[hidden] {
    display: none;
  }

  .lb-nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .lb-counter {
    position: absolute;
    top: 24px;
    left: 50%;
    z-index: 1;
    margin: 0;
    padding: 6px 14px;
    transform: translateX(-50%);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper-2);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-muted);
  }

  .lb-counter:empty {
    display: none;
  }

  .lb-stage {
    display: grid;
    place-items: center;
    touch-action: none;
    user-select: none;
  }

  .lb-stage.zoomed {
    cursor: move;
  }

  .lb-img {
    max-width: 90vw;
    max-height: 90dvh;
    object-fit: contain;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: var(--paper-2);
    pointer-events: none;
    transform-origin: center;
  }

  .lb-stage.from-next {
    animation: lb-from-next 0.2s var(--ease-ink);
  }

  .lb-stage.from-prev {
    animation: lb-from-prev 0.2s var(--ease-ink);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: scale(0.95) translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes lb-from-next {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes lb-from-prev {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 600px) {
    #project-modal {
      --box-radius: 12px;
      width: calc(100% - 1rem);
      max-height: 92dvh;
    }

    .lb-prev {
      left: 8px;
    }

    .lb-next {
      right: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #project-modal[open],
    #project-lightbox[open],
    .lb-stage.from-next,
    .lb-stage.from-prev {
      animation: none;
    }

    .lb-stage,
    .lb-img,
    .lb-control,
    .modal-close {
      transition: none;
    }
  }
</style>
