---
import type { Lang, Strings } from '../i18n';
import { stack } from '../data/stack';
import { responsive } from '../lib/images';
import Section from './Section.astro';

interface Props {
  strings: Strings;
  lang: Lang;
}

const { strings, lang } = Astro.props;
// Painted portrait width = frame width - 26 px (12 px padding + 1 px border per side). From lg the
// frame is the grid column, clamp(320px, 34vw, 440px); below lg it caps at 320 px and shrinks with
// the viewport (24 px side gutters).
const portrait = await responsive('profile/portrait.jpg', [300, 450, 600, 900, 1200]);
const portraitSizes = '(min-width: 1024px) min(414px, calc(34vw - 26px)), min(294px, calc(100vw - 74px))';
const bio = [strings.bioP1, strings.bioP2, strings.bioP3, strings.bioP4, strings.bioP5];
---

<Section id="about" strings={strings}>

    <div class="grid gap-10 md:gap-12 lg:grid-cols-[clamp(320px,34vw,440px)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-12 lg:gap-y-10 xl:grid-rows-[1fr_auto] xl:gap-x-20">
      <!-- Portrait: 4:5 crop on small screens (shorter), 3:4 from lg -->
      <figure class="portrait animate-on-scroll self-start lg:col-start-1 lg:row-start-1">
        <img
          src={portrait.src}
          srcset={portrait.srcset}
          sizes={portraitSizes}
          alt={strings.portraitAlt}
          class="block aspect-[4/5] w-full object-cover object-top lg:aspect-[3/4]"
          loading="lazy"
          decoding="async"
          width={portrait.width}
          height={portrait.height}
        />
      </figure>

      <!-- Bio: pull line, lead paragraph, then the rest -->
      <div class="min-w-0 lg:col-start-2 lg:row-span-2 lg:row-start-1 xl:row-span-1">
        <p class="pull-line animate-on-scroll font-display text-[clamp(20px,2vw,26px)] italic leading-snug text-(--ink-2)">
          {strings.jobTitle}
        </p>

        <div class="bio animate-on-scroll stagger-1 mt-6 space-y-5">
          {bio.map((html) => <p class="bio-text" set:html={html} />)}
        </div>
      </div>

      <!-- Stack: rows under the portrait on lg (fills the column); from xl a full-width band with the
           Career stats rule, label in the portrait column and three columns under the bio -->
      <div class="stack animate-on-scroll stagger-2 mt-6 min-w-0 border-t border-(--line) pt-8 lg:col-start-1 lg:row-start-2 lg:mt-0 lg:self-start xl:col-span-2 xl:mt-6 xl:grid xl:grid-cols-subgrid xl:gap-x-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-(--ink-muted)">{strings.stackLabel}</p>
        <ol class="stack-list mt-5 grid md:max-lg:grid-cols-3 xl:col-start-2 xl:mt-0 xl:grid-cols-3">
          {stack.map((col) => (
            <li class="stack-col">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-(--ink-muted)">
                <span class="text-(--accent)">{col.index}</span> / {col.label[lang]}
              </p>
              <ul class="stack-techs text-[15px] text-(--ink)">
                {col.techs.map((tech) => <li>{tech}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
</Section>

<style>
  .portrait {
    padding: 12px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    max-width: 320px;
  }

  /* Up to 440 px from lg: without the CTA pair, a taller portrait keeps the column level with the bio */
  @media (min-width: 1024px) {
    .portrait {
      max-width: 440px;
    }
  }

  .bio {
    max-width: 62ch;
    font-family: var(--font-ui);
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* Lead paragraph: larger and in full ink so the bio has an entry point */
  .bio-text:first-child {
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--ink);
  }

  /* Stack rows on small screens: label | techs */
  .stack-col {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
  }

  .stack-col + .stack-col {
    border-top: 1px solid var(--line);
  }

  .stack-techs {
    display: grid;
    gap: 0.375rem;
  }

  /* Three columns, label above the techs: md up to lg (single column) and xl+ (band) */
  @media (min-width: 768px) and (max-width: 1023px), (min-width: 1280px) {
    .stack-col {
      display: block;
      padding: 0 1.5rem;
    }

    .stack-col:first-child {
      padding-left: 0;
    }

    .stack-col + .stack-col {
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .stack-techs {
      margin-top: 0.75rem;
    }
  }
</style>
