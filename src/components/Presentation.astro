---
import type { Lang, Strings } from '../i18n';
import { stack } from '../data/stack';
import { responsive } from '../lib/images';
import Section from './Section.astro';

interface Props {
  strings: Strings;
  lang: Lang;
}

const { strings, lang } = Astro.props;
// Painted portrait width = frame width - 26 px (12 px padding + 1 px border per side). From lg the
// frame floats at clamp(320px, 34vw, 440px); below lg it caps at 320 px and shrinks with the
// viewport (24 px side gutters).
const portrait = await responsive('profile/portrait.jpg', [300, 450, 600, 900, 1200]);
// 5 % over the painted width: at 390@3× the exact slot landed at ×1.02 of the chosen file.
const portraitSizes = '(min-width: 1024px) min(435px, calc((34vw - 26px) * 1.05)), min(309px, calc((100vw - 74px) * 1.05))';
const bio = [strings.bioP1, strings.bioP2, strings.bioP3];
---

<Section id="about" strings={strings} subtitle={strings.jobTitle}>

    <!-- Text on the left, portrait floated to the right from lg: once the portrait ends, the
         bio flows across the full width below it -->
    <div class="about-flow">
      <!-- Portrait: 4:5 crop on small screens (shorter), 3:4 from lg -->
      <figure class="portrait animate-on-scroll">
        <img
          src={portrait.src}
          srcset={portrait.srcset}
          sizes={portraitSizes}
          alt={strings.portraitAlt}
          class="block aspect-[4/5] w-full object-cover object-top lg:aspect-[3/4]"
          loading="lazy"
          decoding="async"
          width={portrait.width}
          height={portrait.height}
        />
      </figure>

      <div class="bio animate-on-scroll stagger-1 space-y-5">
        {bio.map((html) => <p class="bio-text" set:html={html} />)}
      </div>
    </div>

    <!-- Stack: full-width band under the bio, with the Career stats rule -->
    <div class="stack animate-on-scroll stagger-2 mt-12 min-w-0 border-t border-(--line) pt-8">
      <p class="label-index text-(--ink-muted)">{strings.stackLabel}</p>
      <ol class="stack-list mt-5 grid md:grid-cols-3">
        {stack.map((col) => (
          <li class="stack-col">
            <p class="label-index text-(--ink-muted)">
              <span class="text-(--accent)">{col.index}</span> / {col.label[lang]}
            </p>
            <ul class="stack-techs text-[15px] text-(--ink)">
              {col.techs.map((tech) => <li>{tech}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
</Section>

<style>
  .about-flow {
    display: flow-root;
  }

  .portrait {
    padding: 12px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    max-width: 320px;
    margin-bottom: 2.5rem;
  }

  /* From lg the portrait floats right at the width it had as a grid column; the bio wraps it */
  @media (min-width: 1024px) {
    .portrait {
      float: right;
      width: clamp(320px, 34vw, 440px);
      max-width: none;
      margin: 0 0 2rem 3rem;
    }
  }

  .bio {
    font-family: var(--font-ui);
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* Lead paragraph: larger and in full ink so the bio has an entry point */
  .bio-text:first-child {
    font-size: clamp(18px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--ink);
  }

  /* Stack rows on small screens: label | techs */
  .stack-col {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
  }

  .stack-col + .stack-col {
    border-top: 1px solid var(--line);
  }

  .stack-techs {
    display: grid;
    gap: 0.375rem;
  }

  /* Three columns, label above the techs, from md */
  @media (min-width: 768px) {
    .stack-col {
      display: block;
      padding: 0 1.5rem;
    }

    .stack-col:first-child {
      padding-left: 0;
    }

    .stack-col + .stack-col {
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .stack-techs {
      margin-top: 0.75rem;
    }
  }
</style>
