---
import type { Strings } from '../i18n/es';
import { contact } from '../data/contact';
import { stack } from '../data/stack';
import { responsive } from '../lib/images';

interface Props {
  strings: Strings;
  lang: 'es' | 'en';
}

const { strings, lang } = Astro.props;
// Portrait box: 294 CSS px wide on mobile, 394 on lg (frame padding excluded).
const portrait = await responsive('profile/portrait.jpg', [300, 450, 600, 900, 1200]);
const portraitSizes = '(min-width: 1024px) 394px, 294px';
const bio = [strings.bioP1, strings.bioP2, strings.bioP3, strings.bioP4, strings.bioP5];
---

<section id="about">
  <div class="section-container grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <!-- Portrait -->
    <figure class="portrait animate-on-scroll self-start">
      <img
        src={portrait.src}
        srcset={portrait.srcset}
        sizes={portraitSizes}
        alt="Alvaro Quintana — Senior Full-Stack Engineer, Madrid"
        class="block aspect-[3/4] w-full object-cover object-top"
        loading="lazy"
        decoding="async"
        width={portrait.width}
        height={portrait.height}
      />
    </figure>

    <!-- Bio -->
    <div class="min-w-0">
      <h2 class="animate-on-scroll font-display text-[clamp(34px,4.4vw,56px)] leading-[1.05] tracking-[-0.01em] text-(--ink)">
        {strings.hiImAlvaro}
      </h2>
      <p class="pull-line animate-on-scroll mt-4 font-display text-[clamp(20px,2vw,26px)] italic leading-snug text-(--ink-2)" style="--stagger: 80ms">
        {strings.jobTitle}
      </p>

      <div class="bio animate-on-scroll mt-8 space-y-5" style="--stagger: 160ms">
        {bio.map((html) => <p class="bio-text" set:html={html} />)}
      </div>

      <div class="animate-on-scroll mt-10 flex flex-wrap gap-3" style="--stagger: 240ms">
        <a href={contact.linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-solid" aria-label={strings.a11yOpenLinkedIn}>{strings.linkedIn}</a>
        <a href={contact.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost" aria-label={strings.a11yOpenGitHub}>{strings.github}</a>
      </div>

      <!-- Stack strip: 01 / Mobile · 02 / Web · 03 / AI -->
      <div class="animate-on-scroll mt-14" style="--stagger: 320ms">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-(--ink-muted)">{strings.stackLabel}</p>
        <ol class="strip mt-4 grid border-t border-(--line) sm:grid-cols-3">
          {stack.map((col) => (
            <li class="strip-col py-5 sm:px-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-(--ink-muted)">
                <span class="text-(--accent)">{col.index}</span> / {col.label[lang]}
              </p>
              <ul class="mt-3 space-y-1.5 text-[15px] text-(--ink)">
                {col.techs.map((tech) => <li>{tech}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .portrait {
    padding: 12px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    max-width: 320px;
  }

  @media (min-width: 1024px) {
    .portrait {
      position: sticky;
      top: 7rem;
      max-width: 420px;
    }
  }

  .bio {
    max-width: 62ch;
    font-family: var(--font-ui);
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .strip-col + .strip-col {
    border-top: 1px solid var(--line);
  }

  @media (min-width: 640px) {
    .strip-col:first-child {
      padding-left: 0;
    }

    .strip-col + .strip-col {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }
</style>
