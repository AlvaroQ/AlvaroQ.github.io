---
// Water-drop ripple scope around the whole Projects section: faint ink rings across the full
// width, behind the content and never over the project images. The effect and its dependencies
// are emitted as their own files and imported by URL on the first mouse hover over the section:
// the loader below has no static imports, so Astro inlines it and the initial load requests no
// ripple code. Off with coarse pointers, reduced motion and forced colours; without WebGL nothing
// changes.
import rippleModule from '../scripts/project-ripple.js?url';
import rippleShader from '../scripts/ripple-shader.js?url';
import rippleColor from '../scripts/ink-color.js?url';
---

<div class="ripple-scope" data-ripple-module={rippleModule} data-ripple-shader={rippleShader} data-ripple-color={rippleColor}>
  <slot />
</div>

<style>
  /* Own stacking context: the canvas (z-index -1) paints above the page background and below
     every card, so the rings run under the text and the images cover them. */
  .ripple-scope {
    position: relative;
    isolation: isolate;
  }
</style>

<style is:global>
  /* Created by src/scripts/project-ripple.js; height and offset follow the viewport (CSSOM). */
  .ripple-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms var(--ease-ink);
  }

  .ripple-canvas.is-on {
    opacity: 1;
  }
</style>

<script>
  type Ripple = { start(e?: PointerEvent): void } | null;

  const scope = document.querySelector<HTMLElement>('[data-ripple-module]');
  const off = ['(pointer: coarse)', '(prefers-reduced-motion: reduce)', '(forced-colors: active)'].some((q) => matchMedia(q).matches);

  if (scope && !off) {
    const { rippleModule, rippleShader, rippleColor } = scope.dataset;

    const first = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
      scope.removeEventListener('pointerenter', first);
      Promise.all([rippleModule, rippleShader, rippleColor].map((url) => import(/* @vite-ignore */ url as string)))
        .then(([ripple, shader, color]) => (ripple as typeof import('../scripts/project-ripple.js')).init(scope, { shader, color }))
        .catch((): Ripple => null)
        .then((fx) => {
          if (fx && scope.matches(':hover')) fx.start();
        });
    };
    scope.addEventListener('pointerenter', first);
  }
</script>
