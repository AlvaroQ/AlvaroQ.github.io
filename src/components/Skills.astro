---
import type { Strings } from '../i18n/es';
import { skillCategories } from '../data/skills';

interface Props {
  strings: Strings;
}

const { strings } = Astro.props;
---

<section id="skills" class="py-20">
  <div class="section-container">
    <div class="text-center mb-12 animate-on-scroll slide-up">
      <h2 class="text-2xl md:text-4xl font-bold text-[var(--neon-cyan)] tracking-[2px] neon-text">
        {strings.skillsMatrix}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {skillCategories.map((cat, i) => (
        <div class="animate-on-scroll slide-up neon-card" style={`animation-delay: ${i * 150}ms;`}>
          <h3 class="text-sm font-bold tracking-wider mb-6 text-center" style={`color: ${cat.color};`}>
            {cat.title}
          </h3>
          <div class="space-y-4">
            {cat.skills.map((skill) => (
              <div>
                <div class="flex justify-between mb-1">
                  <span class="text-xs text-[var(--text-primary)]">{skill.name}</span>
                  <span class="text-[0.6rem] text-[var(--text-secondary)]">{skill.level}%</span>
                </div>
                <div class="skill-bar-track">
                  <div
                    class="skill-bar-fill"
                    data-level={skill.level}
                    style={`background: ${cat.color}; width: 0%;`}
                    role="progressbar"
                    aria-valuenow={skill.level}
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-label={`${strings.a11ySkillLevel}: ${skill.name} ${skill.level}%`}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
