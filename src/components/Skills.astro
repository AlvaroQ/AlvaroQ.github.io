---
import type { Lang, Strings } from '../i18n';
import { skillCategories, type SkillDepth } from '../data/skills';
import Section from './Section.astro';

interface Props {
  strings: Strings;
  lang: Lang;
}

const { strings, lang } = Astro.props;
const depthLabel: Record<SkillDepth, string> = {
  core: strings.depthCore,
  solid: strings.depthSolid,
  familiar: strings.depthFamiliar,
};
---

<Section id="skills" strings={strings}>

    <div class="grid gap-12 md:grid-cols-3 md:gap-10">
      {skillCategories.map((cat, i) => (
        <div class="animate-on-scroll" style={`--stagger: ${i * 80}ms`}>
          <h3 class="border-b border-(--line) pb-3 font-mono text-[11px] uppercase tracking-[0.14em] text-(--ink-muted)">{cat.title[lang]}</h3>
          <ul>
            {cat.skills.map((skill) => (
              <li class="flex items-baseline gap-3 border-b border-(--line) py-3">
                <span class="min-w-0 flex-1 text-[15px] text-(--ink)">{skill.name}</span>
                <span class="font-mono text-xs text-(--ink-muted)">{skill.years} {strings.yearsShort}</span>
                <span class={`depth depth-${skill.depth}`}>{depthLabel[skill.depth]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
</Section>

<style>
  .depth {
    min-width: 72px;
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .depth-core {
    border-color: var(--accent);
    color: var(--accent);
  }

  .depth-solid {
    color: var(--ink);
  }

  .depth-familiar {
    border-style: dashed;
  }
</style>
